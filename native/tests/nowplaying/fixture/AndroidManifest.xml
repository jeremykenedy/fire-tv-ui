<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.jeremykenedy.firetv.nowplayingfixture">
    <uses-sdk android:minSdkVersion="27" android:targetSdkVersion="36" />
    <application android:label="Native media fixture" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".FixtureActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".FixtureReceiver" android:exported="true" />
    </application>
</manifest>
