@@ -0,0 +1,79 @@
+package com.jeremykenedy.firetv.ui;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import java.util.Map;
+import java.util.Objects;
+
+public final class FeaturedCardSize {
+    public static final String WIDTH = "featured_card_width_dp";
+    public static final String HEIGHT = "featured_card_height_dp";
+    public static final String[] LABELS = {"Default", "Compact", "Standard", "Large", "Custom size"};
+    private static final int[][] PRESETS = {{0, 0}, {320, 168}, {400, 210}, {480, 252}};
+    private static volatile int width;
+    private static volatile int height;
+
+    private FeaturedCardSize() {}
+
+    public static boolean valid(Object w, Object h) {
+        return w == null && h == null || w instanceof Integer && h instanceof Integer
+                && (Integer) w >= 240 && (Integer) w <= 600
+                && (Integer) h >= 135 && (Integer) h <= 300;
+    }
+
+    public static synchronized boolean configure(Context context) {
+        Map<String, ?> values = DeviceSettings.prefs(context).getAll();
+        Object w = values.get(WIDTH), h = values.get(HEIGHT);
+        int nextWidth = valid(w, h) && w != null ? (Integer) w : 0;
+        int nextHeight = valid(w, h) && h != null ? (Integer) h : 0;
+        boolean changed = width != nextWidth || height != nextHeight;
+        width = nextWidth;
+        height = nextHeight;
+        return changed;
+    }
+
+    public static float width(float original) { return width == 0 ? original : width; }
+    public static float height(float original) { return height == 0 ? original : height; }
+
+    public static int selected(Context context) {
+        Map<String, ?> values = DeviceSettings.prefs(context).getAll();
+        Object w = values.get(WIDTH), h = values.get(HEIGHT);
+        if (!valid(w, h) || w == null) return 0;
+        for (int i = 1; i < PRESETS.length; i++)
+            if (w.equals(PRESETS[i][0]) && h.equals(PRESETS[i][1])) return i;
+        return 4;
+    }
+
+    public static String label(Context context) {
+        int selected = selected(context);
+        if (selected != 4) return LABELS[selected];
+        Map<String, ?> values = DeviceSettings.prefs(context).getAll();
+        return "Custom (" + values.get(WIDTH) + " x " + values.get(HEIGHT) + " dp)";
+    }
+
+    public static void preset(Context context, int selected) {
+        if (selected < 0 || selected >= PRESETS.length) throw new IllegalArgumentException("Choose a supported card size.");
+        save(context, selected == 0 ? null : PRESETS[selected][0], selected == 0 ? null : PRESETS[selected][1]);
+    }
+
+    public static synchronized void save(Context context, Integer w, Integer h) {
+        if (!valid(w, h)) throw new IllegalArgumentException("Use a width from 240 to 600 dp and a height from 135 to 300 dp.");
+        SharedPreferences prefs = DeviceSettings.prefs(context);
+        Map<String, ?> previous = prefs.getAll();
+        Object oldWidth = previous.get(WIDTH), oldHeight = previous.get(HEIGHT);
+        if (oldWidth != null && !(oldWidth instanceof Integer) || oldHeight != null && !(oldHeight instanceof Integer))
+            throw new IllegalStateException("The saved card size is unavailable.");
+        boolean committed = edit(prefs, w, h).commit();
+        Map<String, ?> actual = prefs.getAll();
+        if (committed && Objects.equals(actual.get(WIDTH), w) && Objects.equals(actual.get(HEIGHT), h)) return;
+        edit(prefs, (Integer) oldWidth, (Integer) oldHeight).commit();
+        throw new IllegalStateException("The card size could not be saved. Please try again.");
+    }
+
+    private static SharedPreferences.Editor edit(SharedPreferences prefs, Integer w, Integer h) {
+        SharedPreferences.Editor edit = prefs.edit();
+        if (w == null) edit.remove(WIDTH); else edit.putInt(WIDTH, w);
+        if (h == null) edit.remove(HEIGHT); else edit.putInt(HEIGHT, h);
+        return edit;
+    }
+}
