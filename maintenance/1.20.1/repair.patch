+
+public final class FeaturedArtwork {
+    private FeaturedArtwork() {}
+
+    public static String title(Context context, String title, String channel, String source,
+            boolean hidden, boolean focused) {
+        if (!hidden || focused) return title;
+        if (channel != null && !channel.trim().isEmpty() && !channel.equals(source)) return channel;
+        return FeedOrder.appName(context, source);
+    }
+
+    public static String subtitle(String title, String subtitle, boolean hidden, boolean focused) {
+        return hidden && !focused && title.equals(subtitle) ? "" : subtitle;
+    }
+}
