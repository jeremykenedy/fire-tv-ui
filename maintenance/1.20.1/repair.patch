index 0000000000000000000000000000000000000000..3b2b22e2b7f4ad18a10f1ff8680bdd08aa71a6f5
--- /dev/null
+++ b/tests/AppearancePresetsTest.java
@@ -0,0 +1,57 @@
+package com.jeremykenedy.firetv.ui;
+
+import android.content.Context;
+import java.io.File;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+public class AppearancePresetsTest {
+    private static void check(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+
+    public static void main(String[] args) throws Exception {
+        Context context = new Context(new File(args[0], "presets"));
+        Map<String, Object> owner = context.prefs.values;
+        for (String key : new String[]{"mode", "custom_wallpaper_uri", "custom_video_uri", "app_order", "display_order",
+                "widgets_config", "icon_pack_package", "app_visibility", "access_token", "fire_tv_ui_equipment_remote"}) owner.put(key, "owner choice");
+        File image = new File(context.getFilesDir(), "owner.png");
+        java.nio.file.Files.write(image.toPath(), new byte[]{1, 2, 3});
+        owner.put("custom_wallpaper_uri", android.net.Uri.fromFile(image).toString());
+        owner.put("mode", "custom");
+        owner.put("app_visibility", "{\"owner.app\":{\"hidden\":false}}");
+        owner.put("icon_focus_growth", 30);
+        owner.put("icon_focus_shadow_size", 38);
+        owner.put("icon_focus_duration_ms", 300);
+        owner.put("menu_animation_frozen", true);
+        owner.put("menu_overlay_frozen", true);
+        owner.put("menu_overlay_palette", "winter");
+        owner.put("menu_overlay_opacity", 75);
+        Map<String, Object> preserved = new LinkedHashMap<>(owner);
+        SavedSetupStore store = new SavedSetupStore(context);
+        owner.put("icon_focus_border_opacity", 0);
+        owner.put("menu_animation", "aurora");
+        String saved = store.save("My original appearance", null);
+        for (int choice = 1; choice < AppearancePresets.NAMES.length; choice++) {
+            SavedSetupSettings.apply(context.prefs, AppearancePresets.values(choice));
+            for (Map.Entry<String, Object> entry : preserved.entrySet())
+                check(entry.getValue().equals(owner.get(entry.getKey())), "Preset changed " + entry.getKey());
+            check(owner.get("icon_focus_border_opacity").equals(90), "Preset focus must be visible");
+            check(store.list().size() == 1 && store.list().get(0).getString("id").equals(saved), "Preset overwrote a named setup");
+        }
+        Map<String, Object> before = new LinkedHashMap<>(owner);
+        context.prefs.failures = 1;
+        try {
+            SavedSetupSettings.apply(context.prefs, AppearancePresets.values(1));
+            throw new AssertionError("Failed commit accepted");
+        } catch (java.io.IOException expected) {}
+        check(owner.equals(before), "Failed preset did not roll back");
+        SavedSetupSettings.apply(context.prefs, AppearancePresets.values(0));
+        for (String key : AppearancePresets.values(0).keySet()) check(!owner.containsKey(key), "Default left managed setting " + key);
+        for (Map.Entry<String, Object> entry : preserved.entrySet())
+            check(entry.getValue().equals(owner.get(entry.getKey())), "Default changed " + entry.getKey());
+        store.apply(saved, true);
+        check(owner.get("menu_animation").equals("aurora") && owner.get("icon_focus_border_opacity").equals(0), "Named setup failed to recover prior appearance");
+        System.out.println("Appearance presets preserve owner settings, motion and named setups; Default and failed writes are bounded.");
+    }
+}
