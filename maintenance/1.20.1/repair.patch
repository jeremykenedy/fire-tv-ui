--- /dev/null
+++ b/scripts/widget_contrast_patch.py
@@ -0,0 +1,68 @@
+"""Choose missing widget text colors against the existing widget surface."""
+from pathlib import Path
+
+
+def once(text, before, after):
+    if text.count(before) != 1:
+        raise ValueError('Expected one widget contrast anchor: ' + before[:100])
+    return text.replace(before, after, 1)
+
+
+def patch_widget_contrast(paths):
+    colors = paths['LQ3/M7;']
+    text = colors.read_text()
+    text = once(text,
+        '    const-string v3, "widget_text_color"\n\n'
+        '    invoke-static {v1, v3, v7, v8, v6}, LQ3/P;->h(Landroid/content/SharedPreferences;Ljava/lang/String;JI)Lb4/g;',
+        '    const-string v3, "widget_text_color"\n'
+        '    invoke-static {v0}, Lcom/jeremykenedy/firetv/ui/WidgetTextDefaults;->color(LQ3/T3;)J\n'
+        '    move-result-wide v7\n'
+        '    invoke-static {v1}, Lcom/jeremykenedy/firetv/ui/WidgetTextContrast;->opacity(Landroid/content/SharedPreferences;)I\n'
+        '    move-result v4\n\n'
+        '    invoke-static {v1, v3, v7, v8, v4}, LQ3/P;->h(Landroid/content/SharedPreferences;Ljava/lang/String;JI)Lb4/g;')
+    text = once(text,
+        '    invoke-static {}, Lg0/M;->t()J\n\n'
+        '    move-result-wide v1\n\n'
+        '    const-string v5, "widget_text_color"',
+        '    invoke-static {v11}, Lcom/jeremykenedy/firetv/ui/WidgetTextDefaults;->color(Landroid/content/SharedPreferences;)J\n\n'
+        '    move-result-wide v1\n\n'
+        '    const-string v5, "widget_text_color"')
+    text = once(text,
+        '    const-string v5, "widget_text_color"\n\n'
+        '    const/16 v7, 0x64\n\n'
+        '    invoke-static {v11, v5, v1, v2, v7}, LQ3/P;->h(Landroid/content/SharedPreferences;Ljava/lang/String;JI)Lb4/g;\n\n'
+        '    move-result-object v1',
+        '    const-string v5, "widget_text_color"\n'
+        '    invoke-static {v11}, Lcom/jeremykenedy/firetv/ui/WidgetTextContrast;->opacity(Landroid/content/SharedPreferences;)I\n'
+        '    move-result v7\n\n'
+        '    invoke-static {v11, v5, v1, v2, v7}, LQ3/P;->h(Landroid/content/SharedPreferences;Ljava/lang/String;JI)Lb4/g;\n\n'
+        '    move-result-object v1\n'
+        '    const/16 v7, 0x64')
+    colors.write_text(text)
+    model = paths['LQ3/T3;']
+    text = model.read_text()
+    start = text.index('.method public constructor <init>(')
+    end = text.index('.end method', start)
+    method = once(text[start:end], '    return-void',
+        '    invoke-static/range {p0 .. p0}, Lcom/jeremykenedy/firetv/ui/WidgetTextDefaults;->initialize(LQ3/T3;)V\n'
+        '    return-void')
+    model.write_text(text[:start] + method + text[end:])
+    getter = paths['LQ3/b6;']
+    text = getter.read_text()
+    start = text.index('    :pswitch_0\n')
+    end = text.index('    :pswitch_1\n', start)
+    branch = once(text[start:end],
+        '    move-result-wide v0\n\n    new-instance v2, Lg0/v;',
+        '    move-result-wide v0\n'
+        '    iget-object v2, p0, LQ3/b6;->h:Ljava/lang/Object;\n'
+        '    check-cast v2, LQ3/T3;\n'
+        '    invoke-static {v2, v0, v1}, Lcom/jeremykenedy/firetv/ui/WidgetTextDefaults;->text(LQ3/T3;J)J\n'
+        '    move-result-wide v0\n\n    new-instance v2, Lg0/v;')
+    getter.write_text(text[:start] + branch + text[end:])
+    main = paths['Lcom/overdevs/at4k/MainActivity;']
+    anchor = '    invoke-super {p0}, Landroid/app/Activity;->onResume()V'
+    main.write_text(once(main.read_text(), anchor, anchor +
+        '\n    invoke-static {p0}, Lcom/jeremykenedy/firetv/ui/WidgetTextDefaults;->resumed(Lcom/overdevs/at4k/MainActivity;)V'))
+    destination = model.parents[1] / 'com/jeremykenedy/firetv/ui/WidgetTextDefaults.smali'
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text((Path(__file__).resolve().parents[1] / 'app/smali/WidgetTextDefaults.smali').read_text())
