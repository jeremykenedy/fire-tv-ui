+    static void prepareShow(Context context, PlexApi api, PlexConnection connection,
+            PlexLibrary.Item selected, long request) throws Exception {
+        String source = connection.sourceKey();
+        java.util.Map<String, PlexLibrary.Item> checked = new java.util.HashMap<>();
+        checked.put(selected.id, selected);
+        ArrayList<ContentProviderOperation> changes = new ArrayList<>();
+        List<SeriesRow> selectedRows = new ArrayList<>();
+        try (Cursor rows = context.getContentResolver().query(
+                TvContract.PreviewPrograms.CONTENT_URI,
+                new String[] {"_id", "package_name", "internal_provider_id", "intent_uri", "internal_provider_data"},
+                null, null, null)) {
+            if (rows == null) throw new java.io.IOException("Plex cards could not be read.");
+            while (rows.moveToNext()) {
+                if (!context.getPackageName().equals(rows.getString(1))) continue;
+                Intent launch = Intent.parseUri(rows.getString(3), Intent.URI_INTENT_SCHEME);
+                Uri uri = launch.getData();
+                if (launch.getComponent() == null
+                        || !(context.getPackageName() + ".PlexItemActivity").equals(launch.getComponent().getClassName())
+                        || uri == null || !"firetvui".equals(uri.getScheme())
+                        || !"plex".equals(uri.getAuthority()) || uri.getQuery() != null
+                        || uri.getFragment() != null || !PlexValues.itemPath(uri.getEncodedPath())
+                        || !source.equals(uri.getPathSegments().get(1))) continue;
+                String id = uri.getPathSegments().get(2);
+                if (!id.equals(rows.getString(2))
+                        && !PlexValues.providerItemId(source, id).equals(rows.getString(2))) continue;
+                if (!PlexSession.current(request)) throw new java.io.IOException("Plex connection changed.");
+                PlexLibrary.Item item = checked.get(id);
+                if (item == null) {
+                    if (checked.size() >= 100) throw new java.io.IOException("Refresh your Plex library cards first.");
+                    List<PlexLibrary.Item> items = PlexLibrary.items(api.server(connection, "/library/metadata/" + id));
+                    if (items.isEmpty() || !id.equals(items.get(0).id))
+                        throw new java.io.IOException("A published Plex item could not be verified.");
+                    item = items.get(0);
+                    checked.put(id, item);
+                }
+                if ("episode".equals(item.type) && item.seriesId.isEmpty())
+                    throw new java.io.IOException("Plex did not identify a published episode's show.");
+                if (!selected.seriesId.equals(item.seriesId)) continue;
+                byte[] existing = rows.isNull(4) ? null : rows.getBlob(4);
+                if (existing != null && existing.length > 8192)
+                    throw new java.io.IOException("Refresh your Plex library cards first.");
+                org.json.JSONObject metadata = existing == null ? new org.json.JSONObject()
+                        : new org.json.JSONObject(new String(existing, java.nio.charset.StandardCharsets.UTF_8));
+                metadata.put("fire_tv_ui_plex_series", seriesData(source, item));
+                Uri target = ContentUris.withAppendedId(TvContract.PreviewPrograms.CONTENT_URI, rows.getLong(0));
+                selectedRows.add(new SeriesRow(target, rows.getString(2), rows.getString(3), existing));
+                changes.add(ContentProviderOperation.newUpdate(target)
+                        .withExpectedCount(1)
+                        .withValue("internal_provider_data", metadata.toString()
+                                .getBytes(java.nio.charset.StandardCharsets.UTF_8)).build());
+            }
+        }
+        if (!PlexSession.commit(request, new PlexSession.Change() {
+            @Override public void apply() throws Exception {
+                // Plex refreshes share this lock. Recheck rows after the network reads before annotating them.
+                for (SeriesRow expected : selectedRows) {
+                    try (Cursor current = context.getContentResolver().query(expected.uri,
+                            new String[] {"package_name", "internal_provider_id", "intent_uri", "internal_provider_data"},
+                            null, null, null)) {
+                        if (current == null || !current.moveToFirst()
+                                || !context.getPackageName().equals(current.getString(0))
+                                || !expected.provider.equals(current.getString(1))
+                                || !expected.intent.equals(current.getString(2))
+                                || !java.util.Arrays.equals(expected.metadata, current.isNull(3) ? null : current.getBlob(3)))
+                            throw new java.io.IOException("Plex cards changed. Try hiding this show again.");
+                    }
+                }
+                if (!changes.isEmpty()) context.getContentResolver().applyBatch(TvContract.AUTHORITY, changes);
+            }
+        })) throw new java.io.IOException("Plex connection changed.");
+    }
