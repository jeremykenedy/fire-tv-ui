new file mode 100644
index 0000000000000000000000000000000000000000..97caf04b0807ce2e153563129c02a72a7bdcfa4e
--- /dev/null
+++ b/tests/UpdateCheckStateTest.java
@@ -0,0 +1,52 @@
+package com.jeremykenedy.firetv.ui;
+
+import java.lang.reflect.*;
+import java.util.*;
+import org.json.JSONObject;
+
+public final class UpdateCheckStateTest {
+    static Class<?> row;
+    static Object get(Object target, String name) throws Exception {
+        Field field = row.getDeclaredField(name); field.setAccessible(true); return field.get(target);
+    }
+    static void set(Object target, String name, Object value) throws Exception {
+        Field field = row.getDeclaredField(name); field.setAccessible(true); field.set(target, value);
+    }
+    static void check(boolean value, String message) {
+        if (!value) throw new AssertionError(message);
+    }
+    static void cleared(Object target) throws Exception {
+        for (String key : new String[]{"published", "publishedCode", "publishedAppVersion"})
+            check(get(target, key) == null, "Stale " + key);
+        check(Boolean.TRUE.equals(get(target, "checking")), "Missing checking state");
+        check(Boolean.FALSE.equals(get(target, "checked")) && Boolean.FALSE.equals(get(target, "staged")), "Stale completion state");
+        check(get(target, "message").equals("Checking published release..."), "Stale message");
+        check(get(target, "sourceRepo").equals("jeremykenedy/example"), "Source changed");
+    }
+    public static void main(String[] args) throws Exception {
+        row = Class.forName("com.jeremykenedy.firetv.ui.UpdatesActivity$Row");
+        Constructor<?> constructor = row.getDeclaredConstructor(String.class, String.class, ScreensaverCatalog.Entry.class);
+        constructor.setAccessible(true);
+        ScreensaverCatalog.Entry release = new ScreensaverCatalog.Entry(new JSONObject()
+                .put("name", "Example").put("package", "example.app").put("repo", "jeremykenedy/example")
+                .put("url", "https://github.com/jeremykenedy/example/releases/download/v1.2.3/example.apk")
+                .put("sha256", String.join("", Collections.nCopies(64, "a"))).put("tag", "v1.2.3").put("dream", "").put("bytes", 100));
+        List<Object> rows = new ArrayList<>();
+        for (String message : new String[]{"Checked release (cached)", "Matches checked release", "Check unavailable: previous failure"}) {
+            Object target = constructor.newInstance(message, "example.app", null);
+            set(target, "published", message.startsWith("Check unavailable") ? null : release);
+            set(target, "publishedCode", 123L); set(target, "publishedAppVersion", "1.2.3");
+            set(target, "staged", true); set(target, "checked", true);
+            set(target, "message", message); set(target, "sourceRepo", "jeremykenedy/example"); rows.add(target);
+        }
+        Method reset = UpdatesActivity.class.getDeclaredMethod("resetCheck", List.class, row); reset.setAccessible(true);
+        reset.invoke(null, rows, rows.get(2)); cleared(rows.get(2));
+        check(get(rows.get(0), "published") == release && get(rows.get(0), "message").equals("Checked release (cached)")
+                && Boolean.TRUE.equals(get(rows.get(0), "checked")) && Boolean.FALSE.equals(get(rows.get(0), "checking")), "Retry changed another cached row");
+        check(get(rows.get(1), "publishedCode").equals(123L) && get(rows.get(1), "publishedAppVersion").equals("1.2.3")
+                && Boolean.TRUE.equals(get(rows.get(1), "staged")) && get(rows.get(1), "message").equals("Matches checked release"), "Retry changed another matched row");
+        reset.invoke(null, rows, null);
+        for (Object target : rows) cleared(target);
+        System.out.println("Actual update check state clears stale results and preserves other retry rows.");
+    }
+}
