+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class WidgetTextContrastChecks(unittest.TestCase):
+    def test_light_dark_transparent_and_custom_widget_surfaces(self):
+        program = '''package com.jeremykenedy.firetv.ui;
+public class WidgetContrastTest {
+ static final class Prefs implements android.content.SharedPreferences {
+  final java.util.Map<String,Object> values=new java.util.HashMap<>();
+  public String getString(String key,String fallback){return (String)values.getOrDefault(key,fallback);}
+  public int getInt(String key,int fallback){return (Integer)values.getOrDefault(key,fallback);}
+ }
+ static void check(boolean ok,String why){if(!ok)throw new AssertionError(why);}
+ public static void main(String[] args){
+ check(WidgetTextContrast.color(.85f,.85f,.85f,0xffffffff,53)==0xff000000,"Light default retains dark text");
+ check(WidgetTextContrast.color(.12f,.12f,.12f,0xffffffff,53)==0xff000000,"Dark wallpaper with light widget surface retains dark text");
+ check(WidgetTextContrast.color(.12f,.06f,.28f,0xff000000,0)==0xffffffff,"Transparent widget over Indigo gets light text");
+ check(WidgetTextContrast.color(.85f,.85f,.85f,0xff000000,100)==0xffffffff,"Opaque black widget surface gets light text");
+ check(WidgetTextContrast.color(.12f,.06f,.28f,0xffffffff,100)==0xff000000,"Opaque white surface gets dark text");
+ check(WidgetTextContrast.color(.1f,.1f,.1f,0x00ffffff,100)==0xff000000,"Opacity control matches native replacement of color alpha");
+ check(WidgetTextContrast.color(.9f,.9f,.9f,0xff000000,-1)==0xff000000,"Invalid negative opacity safely uses wallpaper");
+ Prefs prefs=new Prefs();
+ check(WidgetTextContrast.opacity(prefs)==100,"Absent widget opacity retains its original default");
+ for(int opacity:new int[]{0,50,100}){prefs.values.put("color_widget_text_color_opacity",opacity);check(WidgetTextContrast.opacity(prefs)==opacity,"Stored default-color opacity is retained");}
+ prefs.values.put("color_widget_text_color_opacity",-1);check(WidgetTextContrast.opacity(prefs)==0,"Default-color opacity has a safe lower bound");
+ prefs.values.put("color_widget_text_color_opacity",101);check(WidgetTextContrast.opacity(prefs)==100,"Default-color opacity has a safe upper bound");
+ prefs.values.put("color_widget_bg_color_argb",0xff000000);prefs.values.put("color_widget_bg_color_opacity",0);
+ check(WidgetTextContrast.color(prefs,.9f,.9f,.9f)==0xff000000,"Transparent widgets follow light wallpaper");
+ prefs.values.put("menu_overlay","particles");
+ check(WidgetTextContrast.color(prefs,.9f,.9f,.9f)==0xff000000,"Overlay only does not replace wallpaper base");
+ prefs.values.put("menu_animation","particles");
+ check(WidgetTextContrast.color(prefs,.9f,.9f,.9f)==0xffffffff,"Full dark background overrides light wallpaper");
+ prefs.values.put("menu_animation","still_graphite");prefs.values.put("menu_background_palette","christmas");
+ check(WidgetTextContrast.color(prefs,.9f,.9f,.9f)==0xffffffff,"Selected holiday palette and still background retain readable text");
+ prefs.values.put("color_widget_bg_color_argb",Integer.MIN_VALUE);prefs.values.put("color_widget_bg_color_opacity",53);
+ check(WidgetTextContrast.color(prefs,.1f,.1f,.1f)==0xff000000,"Default background sentinel retains light widget surface");
+ System.out.println("Widget text contrast behavior passed");
+ }}'''
+        with tempfile.TemporaryDirectory() as folder:
+            stub = Path(folder) / 'android/content/SharedPreferences.java'
+            stub.parent.mkdir(parents=True)
+            stub.write_text('package android.content; public interface SharedPreferences {String getString(String k,String d);int getInt(String k,int d);}')
+            source = Path(folder) / 'WidgetContrastTest.java'
+            source.write_text(program)
+            subprocess.run(['javac', '-d', folder, str(stub), *[str(ROOT / 'app/src/com/jeremykenedy/firetv/ui' / name) for name in ('WidgetTextContrast.java','MenuBackgroundOptions.java','HolidayThemes.java')], str(source)], check=True)
+            subprocess.run(['java', '-cp', folder, 'com.jeremykenedy.firetv.ui.WidgetContrastTest'], check=True)
