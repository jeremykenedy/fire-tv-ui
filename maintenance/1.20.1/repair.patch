+package com.jeremykenedy.firetv.ui;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+final class AppearancePresets {
+    static final String[] NAMES = {"Default", "Restrained dark", "Cinematic", "Soft ambient"};
+    static final String[] DETAILS = {
+        "Reset background and app focus style to defaults: show your wallpaper, no overlay and original app focus. This does not restore a previous custom appearance.",
+        "Still warm graphite background and a white app focus border. No overlay. Soft background light and 90% border opacity.",
+        "Still midnight blue background and a warm white app focus border. No overlay. Soft background light and 90% border opacity.",
+        "Flowing silk background and a pale blue app focus border. Slow, sparse motion with soft light, no overlay and 90% border opacity. Your Animated or Still choice is kept."
+    };
+
+    private AppearancePresets() {}
+
+    static Map<String, Object> values(int choice) {
+        if (choice < 0 || choice >= NAMES.length) throw new IllegalArgumentException("Choose an available appearance preset.");
+        Map<String, Object> values = new LinkedHashMap<>();
+        values.put("menu_animation", choice == 0 ? null : choice == 1 ? "still_graphite" : choice == 2 ? "still_midnight" : "silk");
+        values.put("menu_overlay", choice == 0 ? null : "off");
+        values.put("menu_background_palette", null);
+        values.put("menu_animation_speed", choice == 0 ? null : 25);
+        values.put("menu_animation_intensity", choice == 0 ? null : 25);
+        values.put("menu_animation_brightness", choice == 0 ? null : 50);
+        values.put("icon_focus_style", choice == 0 ? null : "border");
+        values.put("icon_focus_border", choice == 0 ? null : choice == 1 ? 0xffffffff : choice == 2 ? 0xffffe4c2 : 0xffc3e5ff);
+        values.put("icon_focus_border_opacity", choice == 0 ? null : 90);
+        return values;
+    }
+}
