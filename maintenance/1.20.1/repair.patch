new file mode 100644
index 0000000000000000000000000000000000000000..0555144b38d8ff8fa5f47bf7556a188f728f9c28
--- /dev/null
+++ b/tests/SettingsFocusReturnTest.java
@@ -0,0 +1,99 @@
+package com.jeremykenedy.firetv.ui;
+
+public final class SettingsFocusReturnTest {
+    private static final class Home implements SettingsFocusReturn.Target {
+        String[] apps = {"first", "middle", "last"};
+        int selected = 1;
+        int focused = -1;
+        boolean open;
+        public String[] identities() { return apps; }
+        public int selectedIndex() { return selected; }
+        public boolean settingsOpen() { return open; }
+        public void focus(int index) { focused = index; }
+    }
+
+    private static Home visit(String selected) {
+        SettingsFocusReturn.reset();
+        Home home = new Home();
+        SettingsFocusReturn.register(home, home);
+        SettingsFocusReturn.selected(selected);
+        SettingsFocusReturn.opened();
+        return home;
+    }
+
+    private static void expect(int expected, Home home) {
+        if (home.focused != expected) throw new AssertionError(expected + " != " + home.focused);
+    }
+
+    public static void main(String[] args) {
+        Home home = visit("middle");
+        SettingsFocusReturn.selected(null);
+        SettingsFocusReturn.selected("first");
+        SettingsFocusReturn.closing().run();
+        expect(1, home);
+        if (SettingsFocusReturn.closing() != null) throw new AssertionError("Completed visit retained");
+
+        home = visit("middle");
+        home.apps = new String[]{"last", "first", "middle"};
+        SettingsFocusReturn.closing().run();
+        expect(2, home);
+
+        home = visit("middle");
+        home.apps = new String[]{"first", "last"};
+        SettingsFocusReturn.closing().run();
+        expect(1, home);
+
+        home = visit("last");
+        home.selected = 2;
+        home.apps = new String[]{"first"};
+        SettingsFocusReturn.closing().run();
+        expect(0, home);
+
+        for (String selected : new String[]{"first", "last"}) {
+            home = visit(selected);
+            SettingsFocusReturn.closing().run();
+            expect(selected.equals("first") ? 0 : 2, home);
+        }
+
+        home = visit("middle");
+        home.apps = new String[0];
+        SettingsFocusReturn.closing().run();
+        expect(-1, home);
+
+        home = visit("middle");
+        Runnable older = SettingsFocusReturn.closing();
+        SettingsFocusReturn.opened();
+        older.run();
+        expect(-1, home);
+        SettingsFocusReturn.closing().run();
+        expect(1, home);
+
+        home = visit("middle");
+        older = SettingsFocusReturn.closing();
+        SettingsFocusReturn.navigation();
+        older.run();
+        expect(-1, home);
+        if (SettingsFocusReturn.closing() != null) throw new AssertionError("Cancelled visit retained");
+
+        home = visit("middle");
+        older = SettingsFocusReturn.closing();
+        Home replacement = new Home();
+        SettingsFocusReturn.register(replacement, replacement);
+        older.run();
+        expect(-1, home);
+        expect(-1, replacement);
+
+        home = visit("middle");
+        home.open = true;
+        SettingsFocusReturn.closing().run();
+        expect(-1, home);
+        if (SettingsFocusReturn.closing() != null) throw new AssertionError("New popup retained old visit");
+
+        home = visit("middle");
+        older = SettingsFocusReturn.closing();
+        SettingsFocusReturn.reset();
+        older.run();
+        expect(-1, home);
+        System.out.println("Settings return identity, fallback and cancellation checks passed");
+    }
+}
