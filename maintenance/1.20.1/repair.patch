diff --git a/app/src/com/jeremykenedy/firetv/ui/WidgetTextContrast.java b/app/src/com/jeremykenedy/firetv/ui/WidgetTextContrast.java
new file mode 100644
index 0000000000000000000000000000000000000000..a43b868dfcd345a8a57c8e7110d02d9cfae74cd5
--- /dev/null
+++ b/app/src/com/jeremykenedy/firetv/ui/WidgetTextContrast.java
@@ -0,0 +1,33 @@
+package com.jeremykenedy.firetv.ui;
+
+import android.content.SharedPreferences;
+
+public final class WidgetTextContrast {
+    private WidgetTextContrast() {}
+
+    public static int opacity(SharedPreferences prefs) {
+        return Math.max(0, Math.min(100, prefs.getInt("color_widget_text_color_opacity", 100)));
+    }
+
+    public static int color(SharedPreferences prefs, float red, float green, float blue) {
+        if (MenuBackgroundOptions.style(prefs.getString(MenuBackgroundOptions.STYLE, "off")) != 0) {
+            HolidayThemes.Theme theme = HolidayThemes.find(prefs.getString(MenuBackgroundOptions.PALETTE, ""));
+            int base = theme == null ? 0xff14213d : theme.middle;
+            float shade = (125 + MenuBackgroundOptions.level(prefs.getInt(MenuBackgroundOptions.BRIGHTNESS, 50))) / 255f;
+            red = ((base >>> 16) & 255) / 255f * shade;
+            green = ((base >>> 8) & 255) / 255f * shade;
+            blue = (base & 255) / 255f * shade;
+        }
+        int background = prefs.getInt("color_widget_bg_color_argb", 0xffffffff);
+        if (background == Integer.MIN_VALUE) background = 0xffffffff;
+        return color(red, green, blue, background, prefs.getInt("color_widget_bg_color_opacity", 53));
+    }
+
+    public static int color(float red, float green, float blue, int background, int opacity) {
+        float alpha = Math.max(0, Math.min(100, opacity)) / 100f;
+        float r = red * (1 - alpha) + ((background >>> 16) & 255) / 255f * alpha;
+        float g = green * (1 - alpha) + ((background >>> 8) & 255) / 255f * alpha;
+        float b = blue * (1 - alpha) + (background & 255) / 255f * alpha;
+        return .299f * r + .587f * g + .114f * b < .5f ? 0xffffffff : 0xff000000;
+    }
+}
