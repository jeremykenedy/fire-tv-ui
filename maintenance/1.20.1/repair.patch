diff --git a/app/src/com/jeremykenedy/firetv/ui/SettingsFocusReturn.java b/app/src/com/jeremykenedy/firetv/ui/SettingsFocusReturn.java
new file mode 100644
index 0000000000000000000000000000000000000000..b25d1f5dabf6b97575cde5a90e7dd91f6bfa2989
--- /dev/null
+++ b/app/src/com/jeremykenedy/firetv/ui/SettingsFocusReturn.java
@@ -0,0 +1,88 @@
+package com.jeremykenedy.firetv.ui;
+
+import java.lang.ref.WeakReference;
+
+/** Retains Home selection only for the lifetime of a Settings visit. */
+public final class SettingsFocusReturn {
+    public interface Target {
+        String[] identities();
+        int selectedIndex();
+        boolean settingsOpen();
+        void focus(int index);
+    }
+
+    private static WeakReference<Object> owner = new WeakReference<>(null);
+    private static Target target;
+    private static String selected;
+    private static String returning;
+    private static int index;
+    private static int generation;
+    private static boolean pending;
+    private static boolean queued;
+
+    private SettingsFocusReturn() {}
+
+    public static void register(Object home, Target current) {
+        if (owner.get() != home) {
+            reset();
+            owner = new WeakReference<>(home);
+        }
+        target = current;
+    }
+
+    public static void selected(String identity) {
+        if (!pending && identity != null) selected = identity;
+    }
+
+    public static void opened() {
+        generation++;
+        returning = selected;
+        index = target == null ? 0 : target.selectedIndex();
+        pending = true;
+        queued = false;
+    }
+
+    public static Runnable closing() {
+        if (!pending || target == null) return null;
+        queued = true;
+        final int visit = ++generation;
+        return new Runnable() {
+            @Override public void run() {
+                if (visit != generation || !pending) return;
+                Target current = target;
+                String identity = returning;
+                int fallback = index;
+                clearPending();
+                if (owner.get() == null || current == null || current.settingsOpen()) return;
+                String[] identities = current.identities();
+                if (identities.length == 0) return;
+                int position = Math.max(0, Math.min(fallback, identities.length - 1));
+                for (int i = 0; i < identities.length; i++) {
+                    if (identity != null && identity.equals(identities[i])) {
+                        position = i;
+                        break;
+                    }
+                }
+                current.focus(position);
+            }
+        };
+    }
+
+    public static void navigation() {
+        if (queued) clearPending();
+    }
+
+    public static void reset() {
+        clearPending();
+        owner.clear();
+        target = null;
+        selected = null;
+    }
+
+    private static void clearPending() {
+        generation++;
+        pending = false;
+        queued = false;
+        returning = null;
+    }
+}
