+++ b/scripts/settings_focus_patch.py
@@ -0,0 +1,47 @@
+"""Keep the existing Home tile selected across a Settings visit."""
+
+
+def replace_once(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError(f'Expected one Settings focus anchor: {old[:80]}')
+    return text.replace(old, new, 1)
+
+
+def patch_settings_focus(paths):
+    helper = 'Lcom/jeremykenedy/firetv/ui/SettingsFocusReturn;'
+    bridge = 'Lcom/jeremykenedy/firetv/ui/SettingsFocusTarget;'
+    path = paths['LQ3/Z3;']
+    text = path.read_text()
+    anchor = '    :goto_0\n    iget-object v2, p0, LQ3/Z3;->h:LQ3/T3;'
+    text = replace_once(text, anchor, '    :goto_0\n'
+        f'    invoke-static {{v1}}, {helper}->selected(Ljava/lang/String;)V\n'
+        '    iget-object v2, p0, LQ3/Z3;->h:LQ3/T3;')
+    path.write_text(text)
+
+    path = paths['LQ3/Q4;']
+    text = path.read_text()
+    anchor = '    :pswitch_3\n    iget-object v0, p0, LQ3/Q4;->h:LQ3/T3;'
+    text = replace_once(text, anchor, '    :pswitch_3\n'
+        f'    invoke-static {{}}, {helper}->opened()V\n'
+        '    iget-object v0, p0, LQ3/Q4;->h:LQ3/T3;')
+    path.write_text(text)
+
+    path = paths['LQ3/T5;']
+    text = path.read_text()
+    anchor = '.method public final h(Ljava/lang/Object;Ljava/lang/Object;)Ljava/lang/Object;\n    .locals 69\n'
+    text = replace_once(text, anchor, anchor + '\n'
+        '    move-object/from16 v0, p0\n'
+        '    iget-object v1, v0, LQ3/T5;->g:LQ3/T3;\n'
+        '    iget-object v2, v0, LQ3/T5;->s:Ljava/util/List;\n'
+        f'    invoke-static {{v1, v2}}, {bridge}->register(LQ3/T3;Ljava/util/List;)V\n')
+    path.write_text(text)
+
+    path = paths['LQ3/y6;']
+    text = path.read_text()
+    anchor = '    :goto_0\n    iget-object p1, p0, LQ3/y6;->m:LQ3/T3;'
+    text = replace_once(text, anchor, '    :goto_0\n'
+        f'    invoke-static {{}}, {bridge}->restore()Z\n'
+        '    move-result p1\n'
+        '    if-nez p1, :goto_1\n'
+        '    iget-object p1, p0, LQ3/y6;->m:LQ3/T3;')
+    path.write_text(text)
