+final class IconPickerSettings {
+    private IconPickerSettings() {}
+
+    static void save(SharedPreferences prefs, String tile, String uri) throws Exception {
+        String previous = prefs.getString("app_visibility", null);
+        JSONObject apps = new JSONObject(previous == null ? "{}" : previous);
+        JSONObject app = apps.optJSONObject(tile);
+        if (app == null) { app = new JSONObject(); apps.put(tile, app); }
+        app.put("customIconUri", uri);
+        if (!prefs.edit().putString("app_visibility", apps.toString()).commit()) {
+            SharedPreferences.Editor restore = prefs.edit();
+            if (previous == null) restore.remove("app_visibility");
+            else restore.putString("app_visibility", previous);
+            restore.commit();
+            throw new IllegalStateException("Icon could not be saved. Try again.");
+        }
+    }
+}
