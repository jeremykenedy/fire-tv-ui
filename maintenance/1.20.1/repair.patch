+    private void cacheContours(Canvas canvas, float w, float h, float scale) {
+        paint.setShader(palette == null ? contourInk : holidayRibbon);
+        paint.setStyle(Paint.Style.STROKE);
+        paint.setStrokeWidth(.7f / scale);
+        for (int ring = 0; ring < 5 + intensity / 20; ring++) {
+            float rx = w * (.12f + ring * .035f), ry = h * (.16f + ring * .05f);
+            float previousX = 0, previousY = 0;
+            path.reset();
+            for (int step = 0; step <= 33; step++) {
+                double angle = step * Math.PI / 16;
+                float radius = 1 + (float) Math.sin(angle * 3 + ring * .18) * .12f
+                        + (float) Math.cos(angle * 5) * .06f;
+                float px = w * .68f + (float) Math.cos(angle) * rx * radius;
+                float py = h * .52f + (float) Math.sin(angle) * ry * radius;
+                if (step == 1) path.moveTo((previousX + px) * .5f, (previousY + py) * .5f);
+                else if (step > 1) path.quadTo(previousX, previousY, (previousX + px) * .5f, (previousY + py) * .5f);
+                previousX = px; previousY = py;
+            }
