+    start = text.index('.method public static final n(LQ3/S8;')
+    end = text.index('.end method', start)
+    method = text[start:end]
+    anchor = '    invoke-virtual {v11}, LN/p;->K()Ljava/lang/Object;\n\n    move-result-object v1'
+    method = once(method, anchor, '    invoke-virtual {v11, v2}, LN/p;->f(Ljava/lang/Object;)Z\n    move-result v3\n' + anchor)
